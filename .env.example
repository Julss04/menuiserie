# Copier ce fichier en .env.local pour le développement, et renseigner les
# mêmes variables dans Vercel (Settings → Environment Variables).

# Mot de passe de l'espace bénévoles (/admin).
ADMIN_PASSWORD=

# Firebase (Firestore) : Console Firebase → Paramètres du projet →
# Comptes de service → Générer une nouvelle clé privée (fichier JSON).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# La clé privée du JSON, entre guillemets, avec ses \n.
FIREBASE_PRIVATE_KEY=

# Resend : clé API (resend.com → API Keys).
RESEND_API_KEY=
# Adresse(s) qui reçoivent les nouvelles réservations, séparées par des virgules.
BOOKING_NOTIFY_TO=
# Expéditeur, une fois le nom de domaine vérifié dans Resend (sinon laisser vide).
BOOKING_NOTIFY_FROM=
